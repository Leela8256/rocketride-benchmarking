# Source before matched_run.sh (or any campaign runner) to reproduce the
# 2026-08/09 cells on the historical engine: RocketRide 3.3.1 with the two
# documented patches (Linux boot pin fix, embedding-transformer duplication
# correction). Without this file, matched_run.sh sources
# official-engine-20261021.env, which selects 3.5.0.584 and forces the patch
# knobs to 0.
#   . run/historical-engine-3.3.1.env && bash run/batch10k_campaign.sh
export ENGINE_VERSION=3.3.1
export ENGINE_URL=https://github.com/rocketride-org/rocketride-server/releases/download/server-v3.3.1/rocketride-server-v3.3.1-linux-x64.tar.gz
export ENGINE_SHA256=95768e2640df2d34dd6dfea2e456f36da03ad80b091f9d057c116dfe748d9747
export ENGINE_ARCHIVE_SHA256=
export RR_DUP_PATCH="${RR_DUP_PATCH:-1}"
export RR_LENSORT_PATCH="${RR_LENSORT_PATCH:-0}"
export PARSE_STOCK_URL="${PARSE_STOCK_URL:-}"
