# Copy to local/local.env and fill in. local.env is git-ignored.
# Ask the AWS admin for your SSO profile if you do not have one yet
# (docs/AWS_BOX_ACCESS.md walks through `aws configure sso`).
BOX_PROFILE=your-sso-profile-name   # the aws cli profile you created with `aws configure sso`
BOX_INSTANCE=i-0bdc8b1e18f2a5348    # the shared benchmark EC2 instance (c7i.8xlarge, us-east-1)
BOX_REGION=us-east-1
# Results prefix in the shared bucket. Keep the default to reuse the staged
# corpora; set your own prefix only for results if asked to.
BENCH_BUCKET=s3://rocketride-benchmark-data
